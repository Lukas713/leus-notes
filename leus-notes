#!/usr/bin/env python3
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
VENV_PYTHON = ROOT / ".venv" / "bin" / "python"
BOOTSTRAPPED = "LEUS_NOTES_BOOTSTRAPPED"


def nvidia_library_dirs() -> list[str]:
    return sorted(str(path) for path in (ROOT / ".venv" / "lib").glob("python3*/site-packages/nvidia/*/lib"))


def restart_inside_venv() -> None:
    if not VENV_PYTHON.exists():
        sys.exit("leus-notes is not installed yet. Run: python3 install.py")
    env = dict(os.environ)
    env[BOOTSTRAPPED] = "1"
    env["LD_LIBRARY_PATH"] = os.pathsep.join(filter(None, [*nvidia_library_dirs(), env.get("LD_LIBRARY_PATH")]))
    env["HF_HOME"] = str(ROOT / "models" / "huggingface")
    env["TORCH_HOME"] = str(ROOT / "models" / "torch")
    env["MPLCONFIGDIR"] = str(ROOT / ".cache" / "matplotlib")
    env["CUDA_CACHE_PATH"] = str(ROOT / ".cache" / "nv")
    env["HF_HUB_DISABLE_TELEMETRY"] = "1"
    env["PYANNOTE_METRICS_ENABLED"] = "0"
    os.execve(VENV_PYTHON, [str(VENV_PYTHON), str(Path(__file__).resolve()), *sys.argv[1:]], env)


def run() -> None:
    sys.path.insert(0, str(ROOT / "src"))
    from leus_notes.cli import main

    sys.exit(main())


if os.environ.get(BOOTSTRAPPED) != "1":
    restart_inside_venv()
run()
